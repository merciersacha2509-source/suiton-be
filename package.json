{
  "name": "suiton-os",
  "version": "1.0.0",
  "private": true,
  "description": "SUITON OS — systeme d'exploitation de SUITON (nettoyage de fin de chantier)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "test:db": "node scripts/test-schema.mjs",
    "audit": "npm run build:prod && node scripts/audit-site.mjs",
    "prod:db": "node scripts/prod/01-migrations.mjs",
    "prod:schema": "node scripts/prod/02-schema.mjs",
    "prod:e2e": "node scripts/prod/04-e2e.mjs",
    "prod:perf": "node scripts/prod/05-perf.mjs",
    "prod:securite": "tsx scripts/prod/06-securite.mjs",
    "go-live": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit && npm run prod:db && npm run prod:schema && npm run prod:coef && npm run prod:seed && npm run prod:e2e && npm run prod:securite && npm run prod:env-sep",
    "prod:coef": "node scripts/prod/07-coef.mjs",
    "demo": "npm run db:seed && next dev",
    "db:seed": "node scripts/db/seed-demo.mjs",
    "db:reset-demo": "node scripts/db/reset-demo.mjs && node scripts/db/seed-demo.mjs",
    "prod:seed": "node scripts/prod/09-seed.mjs",
    "preview": "APP_ENV=preview NEXT_PUBLIC_APP_ENV=preview EMAIL_MODE=preview next build && APP_ENV=preview next start",
    "prod:deploy": "node scripts/garde/production.mjs deploy",
    "prod:migrate": "node scripts/garde/production.mjs migrate",
    "prod:dns": "node scripts/garde/production.mjs dns",
    "prod:env": "node scripts/garde/production.mjs env",
    "prod:env-sep": "node scripts/prod/10-environnements.mjs",
    "build:prod": "APP_ENV=production NEXT_PUBLIC_APP_ENV=production NEXT_PUBLIC_SITE_URL=https://suiton.be next build",
    "audit:seul": "node scripts/audit-site.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.1.1",
    "@fontsource/jura": "5.1.1",
    "@react-pdf/renderer": "^4.6.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0",
    "resend": "^4.1.2",
    "sharp": "^0.33.5",
    "tailwind-merge": "2.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "9.1.0",
    "pg": "8.13.1",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "supabase": "^2.115.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.7.3",
    "vercel": "^59.1.4",
    "vitest": "4.1.10"
  }
}
